{
  // Cloudflare Workers 部署配置（纯静态资源，无 Worker 脚本）
  // 部署：npm run build && npx wrangler deploy -c wrangler.workers.jsonc
  "name": "prompt-box",
  "compatibility_date": "2026-11-03",
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    // 未知路径回落到 dist/404.html
    "not_found_handling": "404-page"
  }
}
